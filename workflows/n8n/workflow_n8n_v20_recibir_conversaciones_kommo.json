      "name": "Resolver Cliente por Entrada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1420, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json.length > 0 && !!$json[0].id_cliente}}", "value2": true }
          ]
        }
      },
      "id": "if-cliente-encontrado",
      "name": "IF Cliente Encontrado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1640, 200]
    },
    {
      "parameters": {
        "jsCode": "const row = $json[0];\nconst base = $('Verificar Secret Kommo').item.json;\nreturn [{\n  json: {\n    ...base,\n    clienteId: row.id_cliente,\n    telefono: (row.clientes && row.clientes.telefono) || null\n  }\n}];"
      },
      "id": "code-fijar-cliente",
      "name": "Fijar Cliente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1860, 120]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://{{$json.subdominio}}.kommo.com/api/v4/leads/{{$json.leadId}}/notes?order[created_at]=desc&limit=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$json.token}}" }
          ]
        },
        "options": {}
      },
      "id": "http-listar-notas",
      "name": "Listar Notas Recientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2080, 120]
    },
    {
      "parameters": {
        "jsCode": "const note = ($json._embedded && $json._embedded.notes && $json._embedded.notes[0]) || null;\nconst base = $('Fijar Cliente').item.json;\n\nif (!note) {\n  return [{ json: { ...base, texto: null, hasAttachment: false, skip: true } }];\n}\n\nconst params = note.params || {};\nconst noteType = note.note_type;\n\n// Heurística: created_by 0/ausente = mensaje del canal (cliente); >0 = agente humano en Kommo.\nconst fromAgent = !!note.created_by && note.created_by !== 0;\n\n// Kommo no documenta públicamente el shape exacto de un adjunto dentro de una\n// nota de chat — se prueban varias formas conocidas. Si ninguna matchea con un\n// caso real, este es el bloque a ajustar (ver aviso en el chat).\nconst directLink = params.link\n  || (params.attachment && params.attachment.link)\n  || params.media\n  || params.file_url\n  || null;\n\nconst fileUuid = params.file_uuid || (params.attachment && params.attachment.file_uuid) || null;\nconst fileName = params.file_name || (params.attachment && params.attachment.file_name) || null;\nconst hasAttachment = noteType === 'attachment' || !!directLink || !!fileUuid;\n\nconst texto = params.text\n  || params.message\n  || (fileName ? `[Archivo] ${fileName}` : (hasAttachment ? '[Archivo]' : '[Mensaje]'));\n\nreturn [{\n  json: {\n    ...base,\n    texto,\n    tipo: fromAgent ? 'saliente' : 'entrante',\n    remitente: fromAgent ? 'outgoing' : 'incoming',\n    hasAttachment,\n    directLink,\n    fileUuid,\n    fileName: fileName || ('kommo_' + Date.now())\n  }\n}];"
      },
      "id": "code-procesar-nota",
      "name": "Procesar Nota",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2300, 120]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{!!$json.hasAttachment}}", "value2": true }
          ]
        }
      },
      "id": "if-hay-adjunto",
      "name": "IF Hay Adjunto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2520, 120]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{!!$json.directLink}}", "value2": true }
          ]
        }
      },
      "id": "if-tiene-link",
      "name": "IF Tiene Link Directo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2740, 40]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://{{$json.subdominio}}.kommo.com/api/v4/files/{{$json.fileUuid}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$json.token}}" }
          ]
        },
        "options": {}
      },
      "id": "http-resolver-archivo",
      "name": "Resolver Archivo (Files API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2960, -60]
    },
    {
      "parameters": {
        "jsCode": "const base = $('Procesar Nota').item.json;\nconst resp = $json || {};\nconst link = resp.download_link\n  || (resp._links && resp._links.download && resp._links.download.href)\n  || (resp._embedded && resp._embedded.download && resp._embedded.download.href)\n  || resp.url\n  || null;\n\nreturn [{ json: { ...base, directLink: link } }];"
      },
      "id": "code-extraer-link-files",
      "name": "Extraer Link Files API",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3180, -60]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.directLink}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$json.token}}" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "http-descargar-archivo",
      "name": "Descargar Archivo Kommo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3400, 40]
    },
    {
      "parameters": {
        "jsCode": "const prev = $json;\nconst mimeType = ($binary && $binary.data && $binary.data.mimeType) || 'application/octet-stream';\n\nfunction guessExt(mt) {\n  const map = { 'image/jpeg': '.jpg', 'image/png': '.png', 'application/pdf': '.pdf', 'audio/ogg': '.ogg', 'audio/mpeg': '.mp3', 'video/mp4': '.mp4' };\n  if (map[mt]) return map[mt];\n  const sub = (mt.split('/')[1] || 'bin').split(';')[0];\n  return '.' + sub;\n}\n\nconst rawName = prev.fileName || ('kommo_' + Date.now());\nconst fileName = /\\.[a-zA-Z0-9]{2,5}$/.test(rawName) ? rawName : rawName + guessExt(mimeType);\n\nreturn [{\n  json: { ...prev },\n  binary: { data: { ...($binary ? $binary.data : {}), fileName, mimeType } }\n}];"
      },
      "id": "code-preparar-binario",
      "name": "Preparar Binario Kommo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3620, 40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.SUPABASE_URL}}/storage/v1/object/whatsapp_media/{{$binary.data.fileName}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
