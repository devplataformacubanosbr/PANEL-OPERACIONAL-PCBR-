    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.SUPABASE_URL}}/storage/v1/object/sign/whatsapp_media/{{$('Preparar Binario Kommo').item.binary.data.fileName}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ expiresIn: 315360000 }) }}",
        "options": {}
      },
      "id": "http-firmar-url",
      "name": "Firmar URL Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [4060, 40]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Preparar Binario Kommo').item.json;\nconst fileName = $('Preparar Binario Kommo').item.binary.data.fileName;\nconst mimeType = $('Preparar Binario Kommo').item.binary.data.mimeType;\nconst signedURL = $json.signedURL || '';\n\nreturn [{\n  json: {\n    mensajeBody: {\n      cliente_id: prev.clienteId,\n      texto: prev.texto,\n      tipo: prev.tipo,\n      proveedor: 'kommo',\n      leido: false,\n      remitente: prev.remitente,\n      telefono: prev.telefono,\n      media_url: signedURL ? `${$vars.SUPABASE_URL}/storage/v1${signedURL}` : null,\n      media_type: mimeType,\n      media_name: fileName\n    }\n  }\n}];"
      },
      "id": "code-fijar-media",
      "name": "Fijar Media",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4280, 40]
    },
    {
      "parameters": {
        "jsCode": "const prev = $json;\nreturn [{\n  json: {\n    mensajeBody: {\n      cliente_id: prev.clienteId,\n      texto: prev.texto,\n      tipo: prev.tipo,\n      proveedor: 'kommo',\n      leido: false,\n      remitente: prev.remitente,\n      telefono: prev.telefono,\n      media_url: null,\n      media_type: null,\n      media_name: null\n    }\n  }\n}];"
      },
      "id": "code-sin-media",
      "name": "Sin Media",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2740, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/mensajes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
