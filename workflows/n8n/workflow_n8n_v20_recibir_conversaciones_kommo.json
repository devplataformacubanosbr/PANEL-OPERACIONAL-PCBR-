      "id": "wh-kommo-notas",
      "name": "Webhook (Recibir Notas Kommo)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "webhookId": "kommo-notas-recibir-v20"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst query = $json.query || {};\n\nconst leadId = body['leads[note][add][0][element_id]']\n  || body['leads[note][update][0][element_id]']\n  || null;\n\nreturn [{\n  json: {\n    valid: !!leadId,\n    leadId: leadId ? parseInt(leadId, 10) : null,\n    secretParam: query.secret || null\n  }\n}];"
      },
      "id": "code-extraer-lead",
      "name": "Extraer Lead Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json.valid}}", "value2": true }
          ]
        }
      },
      "id": "if-hay-lead",
      "name": "IF Hay Lead Id",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [540, 300]
    },
    {
      "parameters": {},
      "id": "noop-ignorar",
      "name": "Ignorar",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 620]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/integraciones_kommo?select=subdominio,token,webhook_secret&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$vars.SUPABASE_SERVICE_ROLE_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "http-integracion-kommo",
      "name": "Obtener Integración Kommo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [760, 200]
    },
    {
      "parameters": {
        "jsCode": "const integ = ($json && $json[0]) || null;\nconst base = $('Extraer Lead Id').item.json;\nconst secretOk = !integ || !integ.webhook_secret || integ.webhook_secret === base.secretParam;\n\nreturn [{\n  json: {\n    ...base,\n    secretOk,\n    subdominio: integ ? integ.subdominio : null,\n    token: integ ? integ.token : null\n  }\n}];"
      },
      "id": "code-verificar-secret",
      "name": "Verificar Secret Kommo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{$json.secretOk}}", "value2": true }
          ]
        }
      },
      "id": "if-secret-valido",
      "name": "IF Secret Válido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/entradas?id_lead=eq.{{$json.leadId}}&select=id_cliente,clientes(telefono)&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$vars.SUPABASE_SERVICE_ROLE_KEY}}" }
          ]
        },
