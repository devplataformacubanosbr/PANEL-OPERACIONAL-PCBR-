# Supabase Public Keys (Required by Frontend)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Security & DRM Protection
# Dominios autorizados para ejecución (separados por coma). Ejemplo:
VITE_AUTHORIZED_HOSTS=operacional.cubanosbr.com,panel.cubanosbr.com

# NOTA DE SEGURIDAD CRÍTICA:
# Las API Keys de IA (GROQ_API_KEY, etc.) NUNCA se configuran aquí en el frontend.
# Están resguardadas en el servidor seguro de Supabase Edge Functions (ai-proxy).
